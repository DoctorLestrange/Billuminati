# Billuminati runs 100% client-side in the browser and requires no API keys or backend secrets.
#
# Optional: Configure a custom base URL path when deploying to a subpath
# (for example, GitHub Pages at https://<user>.github.io/Billuminati/).
# Leave as "/" for root-domain hosting (AI Studio, Vercel, Netlify, Cloudflare Pages).
VITE_BASE_PATH=/
